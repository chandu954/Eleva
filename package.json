{
  "name": "eleva",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.10",
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/static/",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true pnpm build",
    "check:bundles": "node scripts/check-route-bundles.mjs",
    "check:dead-code": "knip --production --include files,dependencies --max-issues 80 --no-progress --no-config-hints",
    "check:duplication": "jscpd src --config .jscpd.json --baseline .jscpd-baseline.json --fail-on-new-clones 0",
    "check:architecture": "NODE_PATH=./node_modules pnpm dlx dependency-cruiser@18.7.2 --config .dependency-cruiser.cjs src",
    "typecheck": "tsc --noEmit --pretty false",
    "check:source-loc": "node scripts/check-source-loc.mjs",
    "check:offline": "node scripts/check-offline-tests.mjs",
    "lint:openapi": "npx @redocly/cli@latest lint docs/openapi.yaml",
    "report:dependency-health": "node scripts/report-dependency-health.mjs --write"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.111",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@posthog/ai": "^7.21.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^10.78.0",
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-bold": "^2.27.3",
    "@tiptap/extension-document": "^2.27.3",
    "@tiptap/extension-history": "^2.27.3",
    "@tiptap/extension-paragraph": "^2.27.3",
    "@tiptap/extension-text": "^2.27.3",
    "@tiptap/extension-text-align": "^2.27.3",
