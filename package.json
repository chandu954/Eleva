    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "ai": "^7.0.165",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "docx": "^9.15.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^11.18.2",
    "ioredis": "^5.11.1",
    "lodash": "^4.18.1",
    "lucide-react": "^0.577.0",
    "marked": "^15.0.12",
    "next": "15.5.28",
    "openai": "^4.104.0",
    "posthog-js": "^1.444.0",
    "react": "^19.3.1",
    "react-circular-progressbar": "^2.2.0",
    "react-dom": "^19.3.1",
