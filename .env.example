# ─── Required ───────────────────────────────────────────────────────────

# Supabase project URL and anon key (from Supabase dashboard settings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# At least one AI provider key is required. Eleva supports multiple providers:
# OpenAI
OPENAI_API_KEY=
# Anthropic Claude
ANTHROPIC_API_KEY=
# OpenRouter (access to 300+ models through one API)
OPENROUTER_API_KEY=
# NVIDIA
NVIDIA_API_KEY=
# Google Gemini
GEMINI_API_KEY=

# ─── Optional ──────────────────────────────────────────────────────────

# Default AI provider configuration (JSON). Example:
# DEFAULT_AI_PROVIDER={"selectedProvider":"openai","selectedModel":"openai/gpt-4o-mini","mode":"single","fallbackEnabled":false}
DEFAULT_AI_PROVIDER=

# Provider key encryption secret (required for user BYOK feature)
# Generate: openssl rand -hex 32
PROVIDER_KEY_ENCRYPTION_SECRET=

# Site URL for redirects and OpenRouter HTTP-Referer header
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe keys (required for subscription features)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Redis (required for rate limiting — Upstash or local)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
USE_LOCAL_REDIS=false
REDIS_URL=

# PostHog analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_PROJECT_API_KEY=
POSTHOG_LLM_ANALYTICS_DISABLED=true

# Auto grant Pro access in dev/preview environments
AUTO_PRO_SUBSCRIPTION=true

# CORS origins (comma-separated)
CORS_ORIGINS=*

# Ollama base URL (for self-hosted models)
OLLAMA_BASE_URL=http://localhost:11434

# CDN base path for assets
NEXT_PUBLIC_BASE_PATH=

# Admin impersonation cookie secret
IMPERSONATION_COOKIE_SECRET=

# ──────────────────────────────────
# Sentry error monitoring (optional)
# ──────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://example@o0.ingest.us.sentry.io/0
SENTRY_ORG=eleva
SENTRY_PROJECT=nextjs
SENTRY_AUTH_TOKEN=
